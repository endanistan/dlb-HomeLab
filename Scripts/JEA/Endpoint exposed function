# function exposed for AUTO1 node in a JEA endpoint, together with a DSC managed schedueld task keeps the AD Group in a desired state
# # #
# DSC Configures scheduled task
# Scheduled task periodiaclly opens a connection using a JEA endpoint with an exposed function that keeps the AD Group in a desired state
# AUTO1 has no access itself to AD DS, the script is run in a group managed service account (gMSA) context.
# # #

function Invoke-SyncOUToAdGroupMembership {
        param (
                [string]$groupName,
                [string]$OU
        )
        $report = @{}
        $desiredMembers = Get-ADUser `
                -SearchBase $OU `
                -Filter {Enabled -eq $true}

        $currentMembers = Get-ADGroupMember `
                -Identity $groupName

        Compare-Object $desiredMembers.sAMAccountName $currentMembers.sAMAccountName | ForEach-Object {
                $user = $_.InputObject
                if ($_.SideIndicator -eq "=>") {
                        Remove-ADGroupMember -Identity $groupName -Members $user -Confirm:$false
                        $report[$user] = "Removed"
                }

                if ($_.SideIndicator -eq "<=") {
                        Add-ADGroupMember -Identity $groupName -Members $user
                        $report[$user] = "Added"
                }
        }
        return $report
}
